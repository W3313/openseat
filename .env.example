# ProfPeek environment (SPEC section 11). Every variable is read once through src/lib/config/env.ts (zod),
# so defaults below match that file. Copy to .env.local and uncomment what you change. Blank values count
# as unset. Client components never read process.env except NEXT_PUBLIC_*.

# ── Data mode ──────────────────────────────────────────────────────────────────────────────────────────
# demo = committed fictional dataset in data/processed/uiuc (default).
# live = real adapters; output goes to data/processed/uiuc-live (gitignored).
DATA_MODE=demo

# TermCode the rankings are built for (also derives the Course Explorer path, e.g. 2026/fall).
CURRENT_TERM=2026-fa

# Comma-separated subjects to seed / ingest.
SUBJECTS=CS,ECE,MATH,PHYS,STAT,CHEM

# Grade window length in years (ingest + scoring).
GRADE_YEARS_BACK=6

# PRNG seed for scripts/seed-demo.ts. Changing it changes the committed dataset hash.
DEMO_SEED=20260903

# ── Claude summaries (scripts/precompute-summaries.ts only; never needed at runtime) ─────────────────
# Absent → extractive summaries.
# ANTHROPIC_API_KEY=

# Model id used with messages.parse.
ANTHROPIC_MODEL=claude-opus-5

# 1 enables the optional server-side refusal fallback beta (SPEC 9.5).
SUMMARY_SERVER_FALLBACKS=0

# Refuse to run more Claude calls than this without --yes.
MAX_SUMMARIES=500

# ── Review source (registry) ───────────────────────────────────────────────────────────────────────────
# demo | rmp | none. rmp requires RMP_ENABLED=1 and DATA_MODE=live; demo with DATA_MODE=live is refused.
REVIEW_SOURCE=demo

# Explicit opt-in for the unofficial RateMyProfessors adapter (ToS compliance is the user's responsibility).
RMP_ENABLED=0

# Override for the RMP school node id; otherwise looked up by name.
# RMP_SCHOOL_ID=

# Authorization header value sent to the RMP GraphQL endpoint.
RMP_AUTH_HEADER=Basic dGVzdDp0ZXN0

# ── UIUC upstream sources ─────────────────────────────────────────────────────────────────────────────
# Source CSV for scripts/fetch-uiuc-gpa.ts (note: main branch).
UIUC_GPA_CSV_URL=https://raw.githubusercontent.com/wadefagen/datasets/main/gpa/uiuc-gpa-dataset.csv

# Course Explorer API base (CourseExplorerSource).
UIUC_COURSE_EXPLORER_BASE=https://courses.illinois.edu/cisapp/explorer/schedule

# Parallel course requests / delay between request starts (ms) for the schedule fetch.
SCHEDULE_FETCH_CONCURRENCY=4
SCHEDULE_FETCH_DELAY_MS=100

# ── Site ───────────────────────────────────────────────────────────────────────────────────────────────
# Absolute origin used by metadata, sitemap, share links and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# When set, tests/smoke/health.test.ts curls ${SMOKE_BASE_URL}/api/health (CI only).
# SMOKE_BASE_URL=

# ── Free model option: Groq (or any OpenAI-compatible endpoint) ──────────────────────────────
# Get a free key at https://console.groq.com/keys. Used by `npm run data:summaries` when no
# ANTHROPIC_API_KEY is set (or SUMMARY_PROVIDER=openai-compatible). Point GROQ_BASE_URL at
# http://localhost:11434/v1 with GROQ_MODEL=qwen3:8b and any non-empty key to use local Ollama instead.
SUMMARY_PROVIDER=auto
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_PROVIDER_NAME=Groq
# 1 = the deployed site may call the model on demand for professors with no valid cached summary
# (never persisted; costs your free-tier quota per uncached view). Default 0: precomputed only.
SUMMARY_ON_DEMAND=0

# Repository link shown in the site header (replace W3313).
NEXT_PUBLIC_REPO_URL=https://github.com/W3313/profpeek
