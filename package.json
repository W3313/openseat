{
  "name": "profpeek",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:ingest": "tsx scripts/ingest.ts --school uiuc",
    "data:rankings": "tsx scripts/build-rankings.ts --school uiuc",
    "data:summaries": "tsx scripts/precompute-summaries.ts --school uiuc",
    "data:fetch": "tsx scripts/fetch-uiuc-gpa.ts && tsx scripts/fetch-purdue.ts && tsx scripts/fetch-uh.ts",
    "data:schedule": "tsx scripts/fetch-uiuc-schedule.ts --term 2026-fa --subjects CS,ECE",
    "data:school": "tsx scripts/ingest.ts --school \"$npm_config_school\" && tsx scripts/build-rankings.ts --school \"$npm_config_school\"",
    "data:uiuc": "tsx scripts/fetch-uiuc-gpa.ts && npm run data:school --school=uiuc",
    "data:purdue": "tsx scripts/fetch-purdue.ts && npm run data:school --school=purdue",
    "data:uh": "tsx scripts/fetch-uh.ts && npm run data:school --school=uh",
    "data:real": "npm run data:uiuc && npm run data:purdue && npm run data:uh",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.123.0",
    "clsx": "2.1.1",
    "csv-parse": "7.0.2",
    "fast-xml-parser": "5.11.1",
    "lucide-react": "1.40.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "description": "Professor rankings from official grade distributions and public schedules, filtered to open sections."
}
