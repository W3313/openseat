{
  "name": "profpeek",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:fetch": "tsx scripts/fetch-uiuc-gpa.ts",
    "data:schedule": "tsx scripts/fetch-uiuc-schedule.ts --term 2026-fa --subjects CS,ECE",
    "data:seed": "tsx scripts/seed-demo.ts",
    "data:ingest": "tsx scripts/ingest.ts --school uiuc",
    "data:rankings": "tsx scripts/build-rankings.ts --school uiuc",
    "data:summaries": "tsx scripts/precompute-summaries.ts --school uiuc",
    "data:all": "npm run data:seed && npm run data:ingest && npm run data:rankings && npm run data:summaries -- --only-missing",
    "data:live": "DATA_MODE=live npm run data:fetch && DATA_MODE=live npm run data:schedule && DATA_MODE=live npm run data:ingest && DATA_MODE=live npm run data:rankings",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run data:all && git diff --exit-code -- data && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.123.0",
    "clsx": "2.1.1",
    "csv-parse": "7.0.2",
    "fast-xml-parser": "5.11.1",
    "lucide-react": "1.40.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "description": "Professor rankings that join official grade distributions with student reviews, filtered to open sections."
}
